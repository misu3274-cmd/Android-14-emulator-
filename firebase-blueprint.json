{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user profile and last-seen Android device metadata.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the signed-in Google user."
        },
        "email": {
          "type": "string",
          "description": "Optional user email address."
        },
        "displayName": {
          "type": "string",
          "description": "User display name."
        },
        "lastDeviceModel": {
          "type": "string",
          "description": "Android Build.MODEL of last connected device."
        },
        "lastAndroidRelease": {
          "type": "string",
          "description": "Android OS release and API level string."
        },
        "lastBuildType": {
          "type": "string",
          "description": "Android Build.TYPE (e.g., userdebug, user, eng)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp set via FieldValue.serverTimestamp()."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp set via FieldValue.serverTimestamp()."
        }
      },
      "required": [
        "userId",
        "displayName",
        "lastDeviceModel",
        "lastAndroidRelease",
        "lastBuildType",
        "createdAt",
        "updatedAt"
      ]
    },
    "DeviceSettings": {
      "title": "DeviceSettings",
      "description": "Cloud-synced device and workbench preferences that persist automatically across sessions.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID."
        },
        "themeMode": {
          "type": "string",
          "enum": ["SYSTEM", "LIGHT", "DARK"],
          "description": "Selected Material 3 theme mode."
        },
        "dynamicColorEnabled": {
          "type": "boolean",
          "description": "Whether Android 12+ dynamic wallpaper color is enabled."
        },
        "compactDensityEnabled": {
          "type": "boolean",
          "description": "Whether compact UI spacing is enabled."
        },
        "hapticsEnabled": {
          "type": "boolean",
          "description": "Whether haptic feedback is enabled on actions."
        },
        "autoSyncEnabled": {
          "type": "boolean",
          "description": "Whether changes auto-sync immediately when online."
        },
        "syncOnMeteredEnabled": {
          "type": "boolean",
          "description": "Whether cloud sync is permitted on metered cellular connections."
        },
        "verboseDebugOverlayEnabled": {
          "type": "boolean",
          "description": "Whether verbose auth and Firestore cache telemetry badges are shown."
        },
        "keepScreenAwakeInDebug": {
          "type": "boolean",
          "description": "Whether to keep screen awake during active testing."
        },
        "defaultTestEnvironment": {
          "type": "string",
          "description": "Active test environment label (e.g., sdk_gphone_api34)."
        },
        "offlineCacheSizeMb": {
          "type": "integer",
          "description": "Configured local offline cache budget in MB (50..500)."
        },
        "syncCounter": {
          "type": "integer",
          "description": "Monotonic counter of synced settings updates."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp set via FieldValue.serverTimestamp()."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp set via FieldValue.serverTimestamp()."
        }
      },
      "required": [
        "userId",
        "themeMode",
        "dynamicColorEnabled",
        "compactDensityEnabled",
        "hapticsEnabled",
        "autoSyncEnabled",
        "syncOnMeteredEnabled",
        "verboseDebugOverlayEnabled",
        "keepScreenAwakeInDebug",
        "defaultTestEnvironment",
        "offlineCacheSizeMb",
        "syncCounter",
        "createdAt",
        "updatedAt"
      ]
    },
    "TestProgressItem": {
      "title": "TestProgressItem",
      "description": "Auto-saved QA test checkpoint, verification task, or debug note synced to cloud.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID."
        },
        "title": {
          "type": "string",
          "description": "Title of the test item or progress note."
        },
        "notes": {
          "type": "string",
          "description": "Detailed observation or reproduction steps."
        },
        "category": {
          "type": "string",
          "enum": ["AUTH", "OFFLINE", "SETTINGS", "DEVICE", "GENERAL"],
          "description": "Category tag for the test item."
        },
        "completed": {
          "type": "boolean",
          "description": "Completion state of the checkpoint."
        },
        "deviceTag": {
          "type": "string",
          "description": "Device model where the item was recorded."
        },
        "sdkInt": {
          "type": "integer",
          "description": "Android SDK_INT level where the item was recorded."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp set via FieldValue.serverTimestamp()."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp set via FieldValue.serverTimestamp()."
        }
      },
      "required": [
        "userId",
        "title",
        "notes",
        "category",
        "completed",
        "deviceTag",
        "sdkInt",
        "createdAt",
        "updatedAt"
      ]
    },
    "DebugLogEntry": {
      "title": "DebugLogEntry",
      "description": "Timestamped auth, network, or cloud sync diagnostic log breadcrumb.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID."
        },
        "eventType": {
          "type": "string",
          "enum": ["AUTH_CHECK", "SYNC_TEST", "NETWORK_CHANGE", "SETTINGS_SYNC", "DEVICE_SNAPSHOT", "CUSTOM_NOTE"],
          "description": "Type of diagnostic event."
        },
        "summary": {
          "type": "string",
          "description": "Short summary of the diagnostic event."
        },
        "details": {
          "type": "string",
          "description": "Additional diagnostic payload or observations."
        },
        "networkState": {
          "type": "string",
          "description": "Network state when recorded."
        },
        "deviceModel": {
          "type": "string",
          "description": "Device Build.MODEL when recorded."
        },
        "androidVersion": {
          "type": "string",
          "description": "Android release string when recorded."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp set via FieldValue.serverTimestamp()."
        }
      },
      "required": [
        "userId",
        "eventType",
        "summary",
        "details",
        "networkState",
        "deviceModel",
        "androidVersion",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "User profile document storing authenticated identity and latest device telemetry."
    },
    "/users/{userId}/settings/{settingId}": {
      "schema": {
        "$ref": "#/entities/DeviceSettings"
      },
      "description": "Cloud-synced device and debugging preferences."
    },
    "/users/{userId}/test_items/{itemId}": {
      "schema": {
        "$ref": "#/entities/TestProgressItem"
      },
      "description": "Auto-saved test progress checkpoints and QA notes."
    },
    "/users/{userId}/debug_logs/{logId}": {
      "schema": {
        "$ref": "#/entities/DebugLogEntry"
      },
      "description": "Diagnostic and auth/sync breadcrumb logs."
    }
  }
}
